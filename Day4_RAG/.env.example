# Copy to `.env` and adjust. `.env` is gitignored; compose reads it
# automatically. Every value here has a working default, so `docker compose
# up` works with no .env at all -- EXCEPT GROQ_API_KEY, without which
# retrieval still runs but no answer can be generated.

# --- Postgres (Day 1's documents table -- the corpus) ---
POSTGRES_USER=docuser
POSTGRES_PASSWORD=docpass
POSTGRES_DB=documents

# --- Answer generation (REQUIRED for `ask`) ---
# The only secret here. Unlike Day 3's optional keys this does not degrade
# gracefully: without it, `ask` retrieves and cites but cannot write an
# answer, and says so explicitly rather than failing obscurely.
GROQ_API_KEY=
ANSWER_MODEL=openai/gpt-oss-120b
# Low but not zero, so repeated runs of `eval` are comparable.
ANSWER_TEMPERATURE=0.1

# --- Chunking ---
# Target characters per chunk. 700 is measured, not guessed: the embedding
# model truncates at 256 TOKENS and silently drops anything past that, so an
# over-long chunk has an unsearchable tail. Sweeping this over the real corpus
# gave 12.6% of chunks truncated at 1000 chars versus 2.7% at 700.
# See the table in app/config.py.
CHUNK_SIZE=700
# Characters repeated between adjacent chunks, so a sentence that straddles a
# boundary is still retrievable in full from one of them.
# MUST be smaller than CHUNK_SIZE -- config rejects the alternative, which
# would otherwise loop forever mid-ingest.
CHUNK_OVERLAP=150
# Below this a chunk is a stray heading or caption: it embeds to something
# near-arbitrary and can score misleadingly high against a short question.
MIN_CHUNK_CHARS=80

# --- Retrieval ---
# How many chunks the vector search returns. 12 is MEASURED at 112 articles:
# top_k=5 gave 96.7% recall, 12 gives 100%, and 16/20 are identical (saturated).
# At 20 articles this value did not matter; at 112 it does -- see app/config.py.
TOP_K=12
# THE REFUSAL GATE. If the best chunk scores below this cosine similarity,
# the answer is "I don't know" and no LLM call is made at all.
# 0.425 is MEASURED at 112 articles over 30 answerable and 13 unanswerable
# questions: it is the highest floor that still keeps 100% recall.
# NOTE the floor is a cheap PRE-FILTER, not the main defence. It kills obvious
# nonsense for free, but cannot separate a near-miss (a real article that does
# not contain the asked-for fact) from a genuine answer -- both score 0.5-0.7.
# The prompt layer handles those. See data/reports/EVAL.md.
SIMILARITY_FLOOR=0.425
# Bounds how much retrieved text is sent to the answer model.
MAX_CONTEXT_CHARS=8000

# --- Embeddings ---
# Runs locally on CPU, no API key, no per-query cost. Changing this changes
# the vector dimension, so the collection must be rebuilt: `ingest --reset`.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage ---
# Chroma persists to this directory. Gitignored: it is derived data that
# `ingest` rebuilds from the API in about a minute.
CHROMA_DIR=chroma_db
COLLECTION_NAME=articles
