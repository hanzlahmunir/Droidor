# Copy to `.env` and adjust. `.env` is gitignored; compose reads it
# automatically. Every value here has a working default in docker-compose.yml,
# so `docker compose up` works with no .env at all.

# --- Postgres ---
POSTGRES_USER=docuser
POSTGRES_PASSWORD=docpass
POSTGRES_DB=documents

# --- Crawler identity ---
# Sent on every request. A real, contactable User-Agent is the minimum
# courtesy for a crawler: it lets a site operator see who we are and ask us
# to stop. Put your own contact details here.
USER_AGENT=DroidorBlogHarvester/1.0 (+https://github.com/hanzlahmunir; educational crawler)

# --- Politeness ---
# Minimum seconds between two requests to the SAME host. robots.txt
# Crawl-delay overrides this whenever it is stricter.
PER_HOST_DELAY_SECONDS=2.0
REQUEST_TIMEOUT_SECONDS=20

# --- Rate limits (persisted in Postgres, so a restart does not reset them) ---
MAX_REQ_PER_HOST_HOUR=60
MAX_REQ_PER_HOST_DAY=300
MAX_REQ_GLOBAL_HOUR=300
MAX_REQ_GLOBAL_DAY=2000
MAX_REQ_GLOBAL_MONTH=20000

# --- Quality thresholds ---
# These define what counts as junk, so they are also what the data-quality
# report measures against. Change them and the report's numbers change.
MIN_ARTICLE_CHARS=300
MAX_LINK_DENSITY=0.35
EXTRACTOR_AGREEMENT_RATIO=0.5

# --- Duplicate detection ---
NEAR_DUPLICATE_THRESHOLD=0.85
SHINGLE_SIZE=5

# --- OPTIONAL: topic discovery only ---
# Both can be left empty. Without GROQ_API_KEY, search results come back
# unranked instead of LLM-filtered. Without TAVILY_API_KEY, search falls back
# to DuckDuckGo, which needs no key at all.
# The crawl pipeline itself requires NEITHER of these.
GROQ_API_KEY=
TAVILY_API_KEY=
