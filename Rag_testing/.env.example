# Copy to .env and fill in the keys you have. The app only shows providers
# whose key is present here, so you can start with just one.
#
# IMPORTANT: put comments on their own lines, never after a value on the same
# line — dotenv treats trailing text as part of the value.

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# xAI / Grok (langchain-xai)
XAI_API_KEY=
# Groq fast inference (langchain-groq) — different from xAI's Grok
GROQ_API_KEY=

# --- Neo4j (matches docker-compose.yml defaults; override for Aura) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=testpassword
# Aura only: its database is often the instance id, not 'neo4j'. Leave blank
# for local Docker (uses the default 'neo4j' database).
NEO4J_DATABASE=

# --- Embeddings (local sentence-transformers; no key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
