# Copy to `.env` and fill in GROQ_API_KEY. `.env` is gitignored; compose reads
# it automatically from this directory.
#
#     cp .env.example .env
#
# Day 5 measures Day 4 rather than configuring it, so almost everything here
# is a MIRROR of Day4_RAG/.env rather than an independent choice. That is the
# one genuinely awkward thing about splitting the directories, and it is worth
# stating plainly: these values do not re-chunk or re-embed anything at eval
# time, but TOP_K and SIMILARITY_FLOOR change what is retrieved and what is
# refused. A score is only comparable to another score taken at the same
# settings, so if you change them in Day 4, change them here too -- or the
# comparison to RESULTS.md is meaningless.

# --- Postgres (Day 1's documents table -- the corpus) ---
POSTGRES_USER=docuser
POSTGRES_PASSWORD=docpass
POSTGRES_DB=documents

# --- Answer generation ---
# REQUIRED for the "Answer correct" and "Refused correctly" lines, which are
# the two that need a generated answer. Without it those cannot be measured:
# retrieval still scores, and `--no-llm` is the explicit way to ask for just
# that half. Running WITHOUT the key and WITHOUT --no-llm reports an error per
# question rather than a zero, so a missing key never looks like a bad score.
GROQ_API_KEY=
ANSWER_MODEL=openai/gpt-oss-120b

# --- Retrieval. Must match what Day 4 ingested with. ---
CHUNK_SIZE=700
CHUNK_OVERLAP=150
TOP_K=12
SIMILARITY_FLOOR=0.425

# --- Storage ---
# The container path. docker-compose.yml mounts ../Day4_RAG/chroma_db here:
# Day 5 READS the index Day 4 wrote and never writes one of its own.
CHROMA_DIR=/app/chroma_db
COLLECTION_NAME=articles
