# Copy this file to `.env` and adjust if you like. `.env` is gitignored.
# docker compose reads `.env` automatically.

# --- Postgres container credentials ---
POSTGRES_USER=docuser
POSTGRES_PASSWORD=docpass
POSTGRES_DB=documents

# --- App connection string (used when running OUTSIDE docker) ---
# Inside docker compose the api service builds this from the values above and
# the `db` hostname; you only need this if you run the app/tests on the host.
DATABASE_URL=postgresql+psycopg://docuser:docpass@localhost:5432/documents

# --- Test database (used by pytest) ---
# Point this at a Postgres you can safely wipe; tests TRUNCATE it.
TEST_DATABASE_URL=postgresql+psycopg://docuser:docpass@localhost:5432/documents_test
