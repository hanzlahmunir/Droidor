# Copy to .env and fill in. .env is gitignored and must NEVER be committed.

# --- Required ---
# Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# --- Optional ---
# Tavily API key for web search (1000 free credits/month, https://tavily.com).
# If unset, web_search falls back to DuckDuckGo (no key, but rate-limited).
TAVILY_API_KEY=tvly-your_key_here

# Model used for normal chat turns.
CHAT_MODEL=llama-3.3-70b-versatile

# Cheaper model used for "easy" turns once routing is enabled (Phase 5).
CHEAP_MODEL=llama-3.1-8b-instant

# Where per-turn cost records are appended (JSONL).
COST_LOG_PATH=logs/cost_log.jsonl
