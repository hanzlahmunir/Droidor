# Copy to .env and fill in. .env is gitignored and must NEVER be committed.

# --- Required ---
# Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# --- Optional ---
# Tavily API key for web search (1000 free credits/month, https://tavily.com).
# If unset, web_search falls back to DuckDuckGo (no key, but rate-limited).
TAVILY_API_KEY=tvly-your_key_here

# Model used for normal chat turns.
# gpt-oss-120b was chosen over llama-3.3-70b-versatile after measuring both:
# on a tool-heavy prompt llama scored 0/4 correct with a 1-in-4 rate of
# malformed tool-call generation, while gpt-oss-120b scored 4/4 with none.
# It is also ~4x cheaper on input. See docs/COST.md.
CHAT_MODEL=openai/gpt-oss-120b

# Cheaper model used for "easy" turns once routing is enabled (Phase 5).
CHEAP_MODEL=openai/gpt-oss-20b

# Where per-turn cost records are appended (JSONL).
COST_LOG_PATH=logs/cost_log.jsonl
